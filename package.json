{
  "name": "jv_api",
  "version": "0.1.0",
  "bin": {
    "jv_api": "bin/jv_api.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run synth > /dev/null",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "server": "ts-node server.ts"
  },
  "overrides": {
    "@smithy/types": "3.3.0"
  },
  "devDependencies": {
    "@humanfs/node": "^0.16.8",
    "@smithy/util-stream": "^4.8.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.2",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^5.0.5",
    "aws-cdk": "^2.1146.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.13.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "neostandard": "^0.14.1",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@middy/core": "6.4.4",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "express": "^5.2.0",
    "iconv-lite": "^0.7.3",
    "luxon": "^3.4.4",
    "source-map-support": "^0.5.21",
    "tar": "^7.5.22"
  }
}
